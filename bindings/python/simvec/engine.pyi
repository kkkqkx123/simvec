from typing import Any, Sequence

class Engine:
    def __init__(self, path: str) -> None: ...
    @property
    def last_code(self) -> int: ...
    @property
    def last_message(self) -> str: ...
    def close(self) -> None: ...
    def __enter__(self) -> Engine: ...
    def __exit__(self, *exc: Any) -> None: ...
    def create_collection(self, name: str, config: dict[str, Any] | None = ...) -> None: ...
    def delete_collection(self, name: str) -> None: ...
    def collection_exists(self, name: str) -> bool: ...
    def list_collections(self) -> list[str]: ...
    def collection_info(self, name: str) -> dict[str, Any]: ...
    def collection_config(self, name: str) -> dict[str, Any]: ...
    def upsert(
        self, collection: str, point_id: str | int, vector: Sequence[float], payload: dict[str, Any] | None = ...
    ) -> None: ...
    def upsert_batch(self, collection: str, points: list[dict[str, Any]]) -> None: ...
    def delete(self, collection: str, point_id: str | int) -> None: ...
    def delete_batch(self, collection: str, point_ids: Sequence[str | int]) -> None: ...
    def delete_by_filter(self, collection: str, query_filter: dict[str, Any]) -> int: ...
    def set_payload(self, collection: str, point_id: str | int, payload: dict[str, Any]) -> None: ...
    def merge_payload(self, collection: str, point_id: str | int, fields: dict[str, Any]) -> None: ...
    def set_payload_field(self, collection: str, point_id: str | int, key: str, value: Any) -> None: ...
    def apply_txn(self, ops: list[dict[str, Any]]) -> None: ...
    def delete_payload_keys(self, collection: str, point_id: str | int, keys: Sequence[str]) -> None: ...
    def create_payload_index(self, collection: str, field: str, schema: str) -> None: ...
    def delete_payload_index(self, collection: str, field: str) -> bool: ...
    def list_payload_indexes(self, collection: str) -> list[dict[str, str]]: ...
    def search(self, collection: str, query: dict[str, Any]) -> list[dict[str, Any]]: ...
    def search_vector(
        self,
        collection: str,
        vector: Sequence[float],
        limit: int,
        query_filter: dict[str, Any] | None = ...,
        score_threshold: float = ...,
        with_payload: bool = ...,
        with_vector: bool = ...,
    ) -> list[dict[str, Any]]: ...
    def get(self, collection: str, point_id: str | int) -> dict[str, Any]: ...
    def count(self, collection: str) -> int: ...
    def count_by_filter(self, collection: str, query_filter: dict[str, Any]) -> int: ...
    def scroll(
        self,
        collection: str,
        limit: int,
        offset: str | None = ...,
        with_payload: bool = ...,
        with_vector: bool = ...,
    ) -> dict[str, Any]: ...
    def scroll_by_filter(
        self,
        collection: str,
        query_filter: dict[str, Any],
        limit: int,
        offset: str | None = ...,
        with_payload: bool = ...,
        with_vector: bool = ...,
    ) -> dict[str, Any]: ...
    def build_index(self, collection: str) -> bool: ...
    def build_quantization(self, collection: str) -> bool: ...
    def has_index(self, collection: str) -> bool: ...
    def has_quantization(self, collection: str) -> bool: ...
    def drop_index(self, collection: str) -> None: ...
    def drop_published_index(self, collection: str) -> None: ...
    def drain_pending(self, collection: str) -> None: ...
    def compact(self, collection: str) -> int: ...
    def collection_metrics(self, collection: str) -> dict[str, Any]: ...
    def run_maintenance_sweep(self) -> None: ...
    def promote_temp_collection(self, live: str, temp: str, backup_suffix: str) -> None: ...
    def restore_promote_backup(self, live: str) -> str: ...
    def list_temp_collections(self) -> list[str]: ...
    def list_old_backups(self, live: str) -> list[str]: ...
    def set_default_hnsw_config(self, config: dict[str, Any]) -> None: ...
    def get_default_hnsw_config(self) -> dict[str, Any] | None: ...
    def set_default_ivf_config(self, config: dict[str, Any]) -> None: ...
    def get_default_ivf_config(self) -> dict[str, Any] | None: ...
    def set_default_quantization_config(self, config: dict[str, Any]) -> None: ...
    def get_default_quantization_config(self) -> dict[str, Any] | None: ...
